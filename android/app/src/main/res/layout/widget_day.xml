<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/w_stripe"
                android:layout_width="4dp"
                android:layout_height="34dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/widget_stripe"
                android:scaleType="fitXY"
                android:contentDescription="@null" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/w_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="فَصْل"
                    android:textColor="#C9A84C"
                    android:textSize="20sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/w_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="Fasl"
                    android:textColor="#8BAF96"
                    android:textSize="12sp" />
            </LinearLayout>
            <ImageView
                android:id="@+id/w_ring"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:visibility="gone"
                android:contentDescription="@null" />
        </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">
            <Chronometer
                android:id="@+id/w_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="#EFE8D8"
                android:textSize="22sp" />
            <TextView
                android:id="@+id/w_until"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="#8BAF96"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/col0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="6dp">
            <ImageView
                android:id="@+id/dot0"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginBottom="3dp"
                android:src="@drawable/widget_dot"
                android:visibility="invisible"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/name0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:maxLines="1"
                android:textColor="#EFE8D8"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/time0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="#EFE8D8"
                android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/col1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="6dp">
            <ImageView
                android:id="@+id/dot1"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginBottom="3dp"
                android:src="@drawable/widget_dot"
                android:visibility="invisible"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/name1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:maxLines="1"
                android:textColor="#EFE8D8"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/time1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="#EFE8D8"
                android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/col2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="6dp">
            <ImageView
                android:id="@+id/dot2"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginBottom="3dp"
                android:src="@drawable/widget_dot"
                android:visibility="invisible"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/name2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:maxLines="1"
                android:textColor="#EFE8D8"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/time2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="#EFE8D8"
                android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/col3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="6dp">
            <ImageView
                android:id="@+id/dot3"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginBottom="3dp"
                android:src="@drawable/widget_dot"
                android:visibility="invisible"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/name3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:maxLines="1"
                android:textColor="#EFE8D8"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/time3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="#EFE8D8"
                android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/col4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="6dp">
            <ImageView
                android:id="@+id/dot4"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginBottom="3dp"
                android:src="@drawable/widget_dot"
                android:visibility="invisible"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/name4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:maxLines="1"
                android:textColor="#EFE8D8"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/time4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="#EFE8D8"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/w_foot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#5F7D68"
        android:textSize="11sp" />
</LinearLayout>
